@using System.Collections.Generic
@model TicketPlatform.Models.Ticket

@{
    ViewBag.Title = "Ticket Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@{
    
    string statusClass = "status-open";

    if (Model.status != null && Model.status.ToLower() == "inprogress")
    {
        statusClass = "status-inprogress";
    }
    else if (Model.status != null && Model.status.ToLower() == "resolved")
    {
        statusClass = "status-resolved";
    }

    List<string> timelineSteps = new List<string>();
    timelineSteps.Add("Open");

    List<TicketPlatform.Models.TicketHistory> history =
        Model.ticketHistory ?? new List<TicketPlatform.Models.TicketHistory>();

    foreach (var h in history)
    {
        if (h.action != null && h.action.ToLower().Contains("inprogress"))
        {
            if (!timelineSteps.Contains("InProgress"))
            {
                timelineSteps.Add("InProgress");
            }
        }

        if (h.action != null && h.action.ToLower().Contains("resolved"))
        {
            if (!timelineSteps.Contains("Resolved"))
            {
                timelineSteps.Add("Resolved");
            }
        }
    }

    if (timelineSteps.Count == 1 && Model.status != null)
    {
        if (Model.status.ToLower() == "inprogress")
        {
            timelineSteps.Add("InProgress");
        }

        if (Model.status.ToLower() == "resolved")
        {
            timelineSteps.Add("InProgress");
            timelineSteps.Add("Resolved");
        }
    }

    int totalSteps = timelineSteps.Count;

    int progressWidth = totalSteps == 1 ? 0 :
                        totalSteps == 2 ? 50 :
                        100;
}
<style>
    
    .ticket-card {
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        padding: 24px;
    }

    .label {
        font-size: 13px;
        color: #6c757d;
        font-weight: 600;
    }

    .value {
        font-size: 15px;
        font-weight: 500;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .status-open {
        background: #ffc107;
        color: #000;
    }

    .status-inprogress {
        background: #17a2b8;
        color: #fff;
    }

    .status-resolved {
        background: #28a745;
        color: #fff;
    }

    .desc-box {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
    }

    .timeline-wrapper {
        position: relative;
        margin-top: 40px;
        height: 110px;
    }

    .timeline-line {
        position: absolute;
        top: 35px;
        left: 0;
        width: 100%;
        height: 6px;
        background: #e0e0e0;
        border-radius: 10px;
    }

    .timeline-progress {
        position: absolute;
        top: 35px;
        left: 0;
        height: 6px;
        background: linear-gradient(90deg, #4facfe, #6f42c1);
        border-radius: 10px;
        transition: width 0.4s ease;
    }

    .timeline-step {
        position: absolute;
        transform: translateX(-50%);
        text-align: center;
    }

        .timeline-step .circle {
            width: 18px;
            height: 18px;
            background: #6f42c1;
            border-radius: 50%;
            margin: auto;
            margin-bottom: 8px;
            border: 3px solid #fff;
            box-shadow: 0 0 0 2px #6f42c1;
        }

    .step-label {
        font-size: 12px;
        font-weight: 600;
        color: #333;
        white-space: nowrap;
    }

    .step-time {
        font-size: 11px;
        color: #777;
    }

    .timeline-step {
        position: absolute;
        transform: translateX(-50%);
        text-align: center;
        top: 0;
    }

    .step-label {
        margin-top: 25px; 
    }

    .step-time {
        margin-top: 5px;
    }
</style>

<div class="container mt-4">

    <div class="ticket-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold">@Model.title</h4>


            <span class="badge badge-status @statusClass">@Model.status</span>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <div class="label">Category</div>
                <div class="value">@Model.category</div>
            </div>
            <div class="col-md-3">
                <div class="label">Request Type</div>
                <div class="value">@Model.requestType</div>
            </div>
            <div class="col-md-3">
                <div class="label">Employee Code</div>
                <div class="value">@Model.employeeCode</div>
            </div>
            <div class="col-md-3">
                <div class="label">Created At</div>
                <div class="value">@DateTime.Parse(Model.createdAt).ToString("dd MMM yyyy HH:mm")</div>
            </div>
        </div>

        <div class="mb-4">
            <div class="label">Description</div>
            <div class="desc-box">@Model.description</div>
        </div>

        <div class="mb-4">
            <div class="label mb-2">Attachments</div>

            @if (Model.attachments != null && Model.attachments.Count > 0)
            {
                foreach (var a in Model.attachments)
                {
                    <div class="mb-1">
                        📎 <a href="@a.fileUrl" target="_blank">@a.fileName</a>
                        <small class="text-muted">(@a.fileType)</small>
                    </div>
                }
            }
            else
            {
                <div class="text-muted">No attachments</div>
            }
        </div>

        <div>


            <div>
                <div class="label mb-3">Ticket Progress</div>



                <div class="timeline-wrapper">

                    <div class="timeline-line"></div>

                    <div class="timeline-progress" style="width:@progressWidth%"></div>

                    @for (int i = 0; i < timelineSteps.Count; i++)
                    {
                        var step = timelineSteps[i];
                        var left = timelineSteps.Count > 1 ? (i * 100.0 / (timelineSteps.Count - 1)) : 0;

                        if (i == 0)
                        {
                            left = 2;   
                        }
                        else if (i == timelineSteps.Count - 1)
                        {
                            left = 98;  
                        }

                        <div class="timeline-step" style="left:@left%">
                            <div class="circle"></div>

                            <div class="step-label">
                                @step
                            </div>
                        </div>
                    }

                </div>
                <div class="mt-4">
                    <div class="label mb-2">Ticket History</div>

                    @if (history.Count > 0)
                    {
                        <ul class="list-group">
                            @foreach (var h in history)
                            {
                                <li class="list-group-item">
                                    <strong>@h.action</strong><br />
                                    <small class="text-muted">
                                        @DateTime.Parse(h.timestamp).ToString("dd MMM yyyy HH:mm")
                                    </small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted">No history available</div>
                    }
                </div>
            </div>
        </div>
        <div class="mt-4 text-end">
            <a href="@Url.Action("MyTickets")" class="btn btn-dark px-4">
                ← Back
            </a>
        </div>

    </div>

</div>